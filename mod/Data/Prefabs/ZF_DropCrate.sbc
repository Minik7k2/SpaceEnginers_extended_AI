<?xml version="1.0" encoding="utf-8"?>
<!--
  ZF_DropCrate — skrzynka zrzutu okupu w surowcach (B+).
  Minimalny grid: kontener + beacon + bateria. Spawnowany przez
  MyAPIGateway.PrefabManager.SpawnPrefab("ZF_DropCrate", ...), po spawnie mod
  ustawia właściciela na 0 (nikt), żeby GRACZ mógł włożyć towar (do wrogiego
  cargo się nie dostanie). Mod obserwuje inwentarz kontenera co tik.

  IsStatic=true I bateria to NIE ozdoba — bez nich sprzątacz śmieci SE zjadał
  skrzynkę zanim gracz doleciał (świat: TrashRemovalEnabled=true, flagi Default
  = 7706 → usuwane są gridy niestatyczne o liczbie bloków < BlockCountThreshold
  (20) dalej niż PlayerDistanceThreshold (500 m) od gracza; flaga Fixed NIE jest
  ustawiona, więc gridy statyczne są nietykalne). Bateria dodatkowo zasila beacon,
  bez niej „ZRZUT" nie świecił na HUD.

  Układ bloków w pionie: kontener y=0, beacon y=1..2 (blok 1x2x1), bateria y=3.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Prefabs>
    <Prefab>
      <Id Type="MyObjectBuilder_PrefabDefinition" Subtype="ZF_DropCrate" />
      <CubeGrids>
        <CubeGrid>
          <SubtypeName />
          <DisplayName>Skrzynka zrzutu</DisplayName>
          <GridSizeEnum>Large</GridSizeEnum>
          <IsStatic>true</IsStatic>
          <PersistentFlags>CastShadows InScene</PersistentFlags>
          <PositionAndOrientation>
            <Position x="0" y="0" z="0" />
            <Forward x="0" y="0" z="-1" />
            <Up x="0" y="1" z="0" />
          </PositionAndOrientation>
          <CubeBlocks>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_CargoContainer">
              <SubtypeName>LargeBlockSmallContainer</SubtypeName>
              <Min x="0" y="0" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
              <ShareMode>None</ShareMode>
              <CustomName>Skrzynka zrzutu</CustomName>
            </MyObjectBuilder_CubeBlock>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_Beacon">
              <SubtypeName>LargeBlockBeacon</SubtypeName>
              <Min x="0" y="1" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
              <CustomName>ZRZUT</CustomName>
              <BroadcastRadius>5000</BroadcastRadius>
            </MyObjectBuilder_CubeBlock>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_BatteryBlock">
              <SubtypeName>LargeBlockBatteryBlock</SubtypeName>
              <Min x="0" y="3" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
              <CustomName>Zasilanie zrzutu</CustomName>
              <Enabled>true</Enabled>
              <CurrentStoredPower>3</CurrentStoredPower>
              <MaxStoredPower>3</MaxStoredPower>
              <ProducerEnabled>true</ProducerEnabled>
              <SemiautoEnabled>false</SemiautoEnabled>
            </MyObjectBuilder_CubeBlock>
          </CubeBlocks>
        </CubeGrid>
      </CubeGrids>
    </Prefab>
  </Prefabs>
</Definitions>
