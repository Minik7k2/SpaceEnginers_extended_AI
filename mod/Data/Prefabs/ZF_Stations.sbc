<?xml version="1.0" encoding="utf-8"?>
<!--
  Stacja frakcji (Etap 6, ostatni brakujący element). Do 2026-08-01 blok kontraktów
  i sklep mogła mieć tylko siatka ODDANA frakcji ręcznie komendą `/zf stacja` — czyli
  w normalnej rozgrywce frakcje nie miały gdzie wystawiać zleceń ani handlować.
  Teraz stawia je StationSpawner, gdy frakcji brakuje własnego punktu ekonomicznego.

  Dlaczego własny prefab, a nie stacja z vanilli: zlecenia z ContractSystem NIE
  pokazują się na stacjach spawnowanych przez vanillowe Economy (znany bug, patrz
  CLAUDE.md), a stacje z DLC odpadają, bo mod ma działać bez dodatków. Tu potrzebne
  są dokładnie dwa bloki — ContractBlock i StoreBlock — obie definicje są z darmowej
  aktualizacji Economy i nie mają wymagania DLC (sprawdzone w CubeBlocks_Economy.sbc).

  IsStatic=true: to stacja, a przy okazji ochrona przed sprzątaczem śmieci SE
  (lekcja z ZF_DropCrate.sbc). Bateria jest naładowana i włączona, bo ContractBlock
  i StoreBlock to bloki funkcyjne — bez zasilania terminal jest martwy.
  Radiolatarnia daje graczowi w ogóle znaleźć stację: mod melduje na czacie dystans,
  ale namierza się ją po sygnale.

  Nazwa wyświetlana NIE MOŻE zaczynać się od „Skrzynka zrzutu" — po tym prefiksie
  RansomManager rozpoznaje osierocone skrzynki okupu i je kasuje.

  Układ (siatka duża): warstwa pancerza y=0 (3x2) niesie cztery bloki na y=1.
  Wszystko styka się ze sobą, więc grid jest spójny.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Prefabs>

    <Prefab>
      <Id Type="MyObjectBuilder_PrefabDefinition" Subtype="ZF_Stacja" />
      <CubeGrids>
        <CubeGrid>
          <SubtypeName />
          <DisplayName>Stacja frakcji</DisplayName>
          <GridSizeEnum>Large</GridSizeEnum>
          <IsStatic>true</IsStatic>
          <PersistentFlags>CastShadows InScene</PersistentFlags>
          <PositionAndOrientation>
            <Position x="0" y="0" z="0" />
            <Forward x="0" y="0" z="-1" />
            <Up x="0" y="1" z="0" />
          </PositionAndOrientation>
          <CubeBlocks>

            <!-- Pokład: 3 x 2 pancerza jako podstawa pod bloki funkcyjne -->
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_CubeBlock">
              <SubtypeName>LargeBlockArmorBlock</SubtypeName>
              <Min x="0" y="0" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
            </MyObjectBuilder_CubeBlock>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_CubeBlock">
              <SubtypeName>LargeBlockArmorBlock</SubtypeName>
              <Min x="1" y="0" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
            </MyObjectBuilder_CubeBlock>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_CubeBlock">
              <SubtypeName>LargeBlockArmorBlock</SubtypeName>
              <Min x="2" y="0" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
            </MyObjectBuilder_CubeBlock>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_CubeBlock">
              <SubtypeName>LargeBlockArmorBlock</SubtypeName>
              <Min x="0" y="0" z="1" />
              <BlockOrientation Forward="Forward" Up="Up" />
            </MyObjectBuilder_CubeBlock>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_CubeBlock">
              <SubtypeName>LargeBlockArmorBlock</SubtypeName>
              <Min x="1" y="0" z="1" />
              <BlockOrientation Forward="Forward" Up="Up" />
            </MyObjectBuilder_CubeBlock>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_CubeBlock">
              <SubtypeName>LargeBlockArmorBlock</SubtypeName>
              <Min x="2" y="0" z="1" />
              <BlockOrientation Forward="Forward" Up="Up" />
            </MyObjectBuilder_CubeBlock>

            <!-- Terminal zleceń: to na nim mod tworzy kontrakty (AddContract) -->
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_ContractBlock">
              <SubtypeName>ContractBlock</SubtypeName>
              <Min x="0" y="1" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
              <CustomName>Terminal zlecen</CustomName>
              <Enabled>true</Enabled>
            </MyObjectBuilder_CubeBlock>

            <!-- Zasilanie obu bloków funkcyjnych -->
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_BatteryBlock">
              <SubtypeName>LargeBlockBatteryBlock</SubtypeName>
              <Min x="1" y="1" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
              <CustomName>Zasilanie stacji</CustomName>
              <Enabled>true</Enabled>
              <CurrentStoredPower>3</CurrentStoredPower>
              <MaxStoredPower>3</MaxStoredPower>
              <ProducerEnabled>true</ProducerEnabled>
              <SemiautoEnabled>false</SemiautoEnabled>
            </MyObjectBuilder_CubeBlock>

            <!-- Sklep: cennik frakcji (price_update) działa na ofertach TEGO bloku.
                 AnyoneCanUse, bo gracz nie należy do frakcji NPC. -->
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_StoreBlock">
              <SubtypeName>StoreBlock</SubtypeName>
              <Min x="2" y="1" z="0" />
              <BlockOrientation Forward="Forward" Up="Up" />
              <CustomName>Sklep frakcji</CustomName>
              <Enabled>true</Enabled>
              <AnyoneCanUse>true</AnyoneCanUse>
            </MyObjectBuilder_CubeBlock>

            <!-- Bez tego gracz nie ma jak trafić do stacji -->
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_Beacon">
              <SubtypeName>LargeBlockBeacon</SubtypeName>
              <Min x="1" y="1" z="1" />
              <BlockOrientation Forward="Forward" Up="Up" />
              <CustomName>STACJA</CustomName>
              <Enabled>true</Enabled>
              <BroadcastRadius>50000</BroadcastRadius>
            </MyObjectBuilder_CubeBlock>

          </CubeBlocks>
        </CubeGrid>
      </CubeGrids>
    </Prefab>

  </Prefabs>
</Definitions>
