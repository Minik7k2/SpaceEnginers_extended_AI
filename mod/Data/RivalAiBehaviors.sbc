<?xml version="1.0"?>
<!-- Profile zachowań RivalAI dla ZyweFrakcje (Etap 5, rajdy). Zgodnie z wiki MES
     "Behaviors: Getting Started": profil to definicja EntityComponent (TypeId=Inventory
     jest "pusty" i nie rusza gry), a konfiguracja siedzi w <Description> jako tagi.
     SpawnGroup wskazuje ten SubtypeId w <Behaviour> prefaba, a MES podpina zachowanie
     (wymaga [UseRivalAi:true] + [RivalAiReplaceRemoteControl:true], bo vanilla dron nie
     ma bloku AI Module). Fighter = namierza cel w zasięgu i leci na niego z atakiem. -->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>ZF_Fighter</SubtypeId>
      </Id>
      <Description>

      [RivalAI Behavior]
      [BehaviorName:Fighter]

      </Description>
    </EntityComponent>

    <!-- Konwój (2026-08-01). Wcześniej konwoje w ogóle nie miały pilota:
         [UseRivalAi:false] + pusty <Behaviour>, więc statek dostawał prędkość początkową
         i DRYFOWAŁ po prostej — nie nawigował, nie omijał, nie wracał. Teraz jedzie
         zachowaniem CargoShip: leci trasą i po niej znika, czyli zachowuje się jak
         prawdziwy transport przelotowy.
         BehaviorName:CargoShip jest jedną z dozwolonych wartości wg wiki MES (CargoShip,
         Escort, Fighter, HorseFighter, Horsefly, Hunter, Nautical, Passive, Patrol, Strike).
         AutopilotData wskazuje GOTOWY profil MES — nie ma sensu dublować sprawdzonych
         nastaw (prędkości, tolerancja punktów trasy, poziomowanie w grawitacji), a
         GetSpeedFromSpawnGroup sprawia, że <Speed> z naszej grupy dalej rządzi tempem. -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>ZF_Konwoj</SubtypeId>
      </Id>
      <Description>

      [RivalAI Behavior]
      [BehaviorName:CargoShip]
      [AutopilotData:MES-DefaultAutoPilot-CargoShip]
      [UsePauseAutopilotFromSpawnGroup:true]
      [GetSpeedFromSpawnGroup:true]

      </Description>
    </EntityComponent>

  </EntityComponents>
</Definitions>
